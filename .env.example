# Postgres connection string. Locally: point at your own Postgres instance.
# On Vercel: add a Postgres database from the project's Storage tab (Neon-backed,
# free tier available) — it injects this for you, or copy its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API key for the guided-intake AI engine (adaptive questions + tailored
# plan generation). Get one at https://console.anthropic.com/settings/keys.
# Without this set, the intake API returns a clear "AI engine not configured" error
# instead of silently failing.
ANTHROPIC_API_KEY=""
